# Read by docker-compose (not by the backend directly — that's backend/.env).
# Copy to .env and adjust. Never commit .env.

# Points every teammate's docker-compose container at the same real Atlas
# data instead of an empty local `mongo` container. Ask a teammate for the
# connection string, or leave unset to fall back to the local container.
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/CommunicationIQ"

JWT_SECRET=commiq-dev-secret-do-not-use-in-prod
