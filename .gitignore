# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Node / Next
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Environment
.env
.env.local
!.env.example

# Working storage — student audio never belongs in version control (DPDP)
tmp/**
!tmp/recordings/.gitkeep
!tmp/prompts/.gitkeep
!tmp/exports/.gitkeep

# TLS material for LAN smoke testing. Generated by run-smoke-test.ps1 on
# demand, so there is nothing to lose by excluding it -- and a private key in
# a repository is a private key that outlives every place you remember putting
# it.
backend/certs/

# Render/local build output
.render/

# Logs
*.log
