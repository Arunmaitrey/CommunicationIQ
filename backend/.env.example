# Copy to .env and adjust. Never commit .env.
MONGO_URI=mongodb://localhost:27017/CommunicationIQ
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
JWT_SECRET=commiq-dev-secret-do-not-use-in-prod
APP_URL=http://localhost:3010
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]

# Working storage. Everything (student audio, prompts, exports) lands under here
# until object storage is wired in behind the Storage contract.
MEDIA_ROOT=../tmp
RECORDING_RETENTION_DAYS=30

# Tier-1 speech engine. Runs locally on CPU; no audio leaves the host.
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_WARM_ON_STARTUP=true
